# Copy this file to `.env` and fill in the values.
#
# IMPORTANT:
# - Do NOT commit your `.env` file (it is ignored by `.gitignore`).
# - You only need API keys for the provider(s) selected in `os_computer_use/config.py`.

# Get your API key here: https://e2b.dev/
E2B_API_KEY="YOUR_E2B_API_KEY"

# Optional: LLM provider keys (only if used by your config)
FIREWORKS_API_KEY=""
OPENROUTER_API_KEY=""
LLAMA_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
MOONSHOT_API_KEY=""

# Optional/Recommended: Hugging Face token to bypass Gradio rate limits
HF_TOKEN=""
